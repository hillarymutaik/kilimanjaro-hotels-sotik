# Copy to .env and fill in. Used only when the database is first created.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-password

# Where the SQLite database and uploaded photos are stored.
# On a host, point this at a PERSISTENT disk/volume.
DATA_DIR=./data

PORT=3001

# Set TRUST_PROXY=0 if the app is NOT behind a reverse proxy (Render, Railway and nginx are proxies).
# TRUST_PROXY=0
