{
  "name": "kilimanjaro-hotels-sotik",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "build:static": "vite build && node scripts/build-static.mjs",
    "start": "node --env-file-if-exists=.env server/index.js",
    "preview": "npm run build && npm start"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "express": "^4.22.3",
    "multer": "^2.5.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=22.13"
  }
}
